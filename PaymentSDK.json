  "eventsFunctions": [
    {
      "name": "CreatePaymentAddress",
      "fullName": "Create Payment Address",
      "description": "Create a temporary payment address for receiving crypto payments",
      "category": "Payments",
      "helpPath": "https://github.com/FreetimeMaker/Payment-SDK",
      "parameters": [
        {
          "name": "Amount",
          "description": "Payment amount in USD or crypto",
          "type": "number"
        },
        {
          "name": "CoinType",
          "description": "Cryptocurrency type (BTC, ETH, LTC, SOL, etc.)",
          "type": "string"
        },
        {
          "name": "Reference",
          "description": "Customer reference (optional)",
          "type": "string",
          "optional": true
        }
      ],
      "returns": {
        "type": "object",
        "properties": {
          "id": "Payment ID",
          "address": "Payment address",
          "amount": "Amount to pay",
          "coinType": "Cryptocurrency type"
        }
      }
    },
    {
      "name": "CheckPaymentStatus",
      "fullName": "Check Payment Status",
      "description": "Check the status of a payment transaction",
      "category": "Payments",
      "parameters": [
        {
          "name": "PaymentID",
          "description": "Payment transaction ID",
          "type": "string"
        }
      ],
      "returns": {
        "type": "string",
        "description": "Status: PENDING, CONFIRMED, EXPIRED, FAILED, or NOT_FOUND"
      }
    },
