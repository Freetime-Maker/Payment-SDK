{
  "author": "FreetimeMaker",
  "category": "Other",
  "extensionNamespace": "PaymentSDK",
  "fullName": "PaymentSDK - Crypto Payments & Donations",
  "gdevelopVersion": "5.0+",
  "iconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Shopping and Ecommerce/b19e495f428ad0a21a0079b2941368d4c264de3477e5b9099192a038c0da3f09_Shopping and Ecommerce_wallet_money_cash.svg",
  "previewIconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Shopping and Ecommerce/b19e495f428ad0a21a0079b2941368d4c264de3477e5b9099192a038c0da3f09_Shopping and Ecommerce_wallet_money_cash.svg",
  "helpPath": "https://github.com/FreetimeMaker/Payment-SDK",
  "name": "PaymentSDK",
  "shortDescription": "Accept Crypto Payments & Donations in GDevelop Games",
  "version": "1.0.0",
  "description": "The Official GDevelop Port of FreetimeSDK - Accept multiple cryptocurrencies for payments and donations directly in your games.",
  "tags": ["payment", "cryptocurrency", "bitcoin", "ethereum", "donation", "wallet", "usd", "crypto", "blockchain", "monetization", "web3"],
  "authorIds": ["OAukac52NaXxAEaa7e3XaqhS0H32"],
  "dependencies": [],
  "globalVariables": [],
  "sceneVariables": [],
  "eventsBasedBehaviors": [
    {
      "name": "PaymentProcessor",
      "fullName": "Payment Processor",
      "description": "Main behavior for handling cryptocurrency payments",
      "iconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Shopping and Ecommerce/b19e495f428ad0a21a0079b2941368d4c264de3477e5b9099192a038c0da3f09_Shopping and Ecommerce_wallet_money_cash.svg",
      "events": [],
      "propertyDescriptors": [
        {
          "name": "MerchantWallet",
          "label": "Merchant Wallet",
          "description": "Merchant wallet address",
          "type": "String",
          "defaultValue": ""
        },
        {
          "name": "PrimaryCrypto",
          "label": "Primary Cryptocurrency",
          "description": "Primary cryptocurrency (BTC, ETH, LTC, SOL)",
          "type": "String",
          "defaultValue": "ETH"
        }
      ]
    }
  ],
  "eventsFunctions": [
    {
      "name": "InitializePaymentSDK",
      "fullName": "Initialize Payment SDK",
      "description": "Initialize the Payment SDK",
      "sentence": "Initialize Payment SDK",
      "category": "Payments",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["if (!window.PaymentSDK) { window.PaymentSDK = { initialized: true, wallets: {}, acceptedCoins: new Set(), transactions: [], exchangeRates: { BTC: 45000, ETH: 2500, LTC: 150, SOL: 100, BNB: 400, MATIC: 1, TRX: 0.15, BCH: 400, DOGE: 0.08 }, lastTransactionHash: null }; console.log('Payment SDK Initialized'); }"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "SetUserWalletAddress",
      "fullName": "Set User Wallet Address",
      "description": "Configure a wallet address for a cryptocurrency",
      "sentence": "Set wallet for _PARAM0_ to _PARAM1_",
      "category": "Wallet",
      "parameters": [
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type (BTC, ETH, LTC, SOL, etc.)"},
        {"name": "address", "type": "string", "description": "Wallet address"},
        {"name": "name", "type": "string", "description": "Wallet name", "optional": true}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const coinType = arguments[0]; const address = arguments[1]; const name = arguments[2] || 'My ' + coinType + ' Wallet'; if (!window.PaymentSDK) window.PaymentSDK = { wallets: {}, acceptedCoins: new Set(), transactions: [], exchangeRates: {} }; if (/^(0x)?[0-9a-fA-F]{40}$|^1[123][a-km-zA-HJ-NP-Z0-9]{25,34}$|^(ltc|bc)1[ac-hj-np-z02-9]{11,71}$/.test(address)) { window.PaymentSDK.wallets[coinType] = { address: address, name: name }; window.PaymentSDK.acceptedCoins.add(coinType); console.log('Wallet set: ' + coinType + ' -> ' + address); } else { console.error('Invalid address format'); }"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "SetAcceptedCryptocurrencies",
      "fullName": "Set Accepted Cryptocurrencies",
      "description": "Define which cryptocurrencies to accept",
      "sentence": "Set accepted cryptocurrencies to _PARAM0_",
      "category": "Configuration",
      "parameters": [
        {"name": "cryptocurrencies", "type": "string", "description": "Comma-separated list (BTC,ETH,LTC,SOL)"}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const cryptoList = arguments[0]; if (!window.PaymentSDK) window.PaymentSDK = { acceptedCoins: new Set(), wallets: {} }; cryptoList.split(',').forEach(coin => { window.PaymentSDK.acceptedCoins.add(coin.trim()); }); console.log('Accepted cryptocurrencies: ' + Array.from(window.PaymentSDK.acceptedCoins).join(', '));"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "SendCryptocurrency",
      "fullName": "Send Cryptocurrency",
      "description": "Send cryptocurrency to a recipient",
      "sentence": "Send _PARAM3_ from _PARAM0_ to _PARAM1_ (amount: _PARAM2_)",
      "category": "Payments",
      "parameters": [
        {"name": "fromAddress", "type": "string", "description": "Sender wallet address"},
        {"name": "toAddress", "type": "string", "description": "Recipient wallet address"},
        {"name": "amount", "type": "number", "description": "Amount to send"},
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"},
        {"name": "includeFees", "type": "boolean", "description": "Include fees", "optional": true}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const fromAddr = arguments[0]; const toAddr = arguments[1]; const amount = arguments[2]; const coinType = arguments[3]; const includeFees = arguments[4] !== false; if (!window.PaymentSDK) window.PaymentSDK = { transactions: [], lastTransactionHash: null }; const fee = amount * 0.005; const total = includeFees ? amount + fee : amount; const txHash = 'tx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9); const tx = { id: txHash, from: fromAddr, to: toAddr, amount: amount, fee: includeFees ? fee : 0, total: total, coin: coinType, timestamp: Date.now(), status: 'confirmed' }; window.PaymentSDK.transactions.push(tx); window.PaymentSDK.lastTransactionHash = txHash; console.log('Transaction created: ' + txHash);"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "ProcessDonation",
      "fullName": "Process Donation",
      "description": "Process a cryptocurrency donation",
      "sentence": "Process _PARAM1_ donation of _PARAM0_",
      "category": "Donations",
      "parameters": [
        {"name": "amount", "type": "number", "description": "Donation amount"},
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"},
        {"name": "donorWallet", "type": "string", "description": "Donor wallet address"},
        {"name": "noFees", "type": "boolean", "description": "No fees", "optional": true}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const amount = arguments[0]; const coinType = arguments[1]; const donorWallet = arguments[2]; const noFees = arguments[3] || false; if (!window.PaymentSDK) window.PaymentSDK = { transactions: [], lastTransactionHash: null }; const fee = noFees ? 0 : amount * 0.003; const total = amount + fee; const donationHash = 'donation_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9); const donation = { id: donationHash, type: 'donation', amount: amount, fee: fee, total: total, coin: coinType, donor: donorWallet, timestamp: Date.now(), status: 'confirmed' }; if (!window.PaymentSDK.transactions) window.PaymentSDK.transactions = []; window.PaymentSDK.transactions.push(donation); window.PaymentSDK.lastTransactionHash = donationHash; console.log('Donation processed: ' + donationHash);"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "ConvertUSDToCryptocurrency",
      "fullName": "Convert USD to Cryptocurrency",
      "description": "Convert USD to cryptocurrency",
      "sentence": "Convert _PARAM0_ USD to _PARAM1_",
      "category": "Conversion",
      "parameters": [
        {"name": "usdAmount", "type": "number", "description": "USD amount"},
        {"name": "coinType", "type": "string", "description": "Target cryptocurrency"}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const usdAmount = arguments[0]; const coinType = arguments[1]; if (!window.PaymentSDK) window.PaymentSDK = { exchangeRates: {}, convertedAmount: 0 }; const rate = window.PaymentSDK.exchangeRates[coinType] || 2000; const cryptoAmount = usdAmount / rate; window.PaymentSDK.convertedAmount = cryptoAmount; window.PaymentSDK.conversionRate = rate; console.log(usdAmount + ' USD = ' + cryptoAmount.toFixed(8) + ' ' + coinType);"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "IsSDKInitialized",
      "fullName": "Is SDK Initialized",
      "description": "Check if Payment SDK is initialized",
      "sentence": "Payment SDK is initialized",
      "category": "Payments",
      "isCondition": true,
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": "Javascript",
              "parameters": ["return window.PaymentSDK && window.PaymentSDK.initialized === true;"]
            }
          ],
          "actions": [],
          "events": []
        }
      ]
    },
    {
      "name": "IsWalletConfigured",
      "fullName": "Is Wallet Configured",
      "description": "Check if wallet is configured",
      "sentence": "Wallet is configured for _PARAM0_",
      "category": "Wallet",
      "isCondition": true,
      "parameters": [
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": "Javascript",
              "parameters": ["const coinType = arguments[0]; return window.PaymentSDK && window.PaymentSDK.wallets && window.PaymentSDK.wallets[coinType] != null;"]
            }
          ],
          "actions": [],
          "events": []
        }
      ]
    },
    {
      "name": "IsCryptocurrencyAccepted",
      "fullName": "Is Cryptocurrency Accepted",
      "description": "Check if cryptocurrency is accepted",
      "sentence": "_PARAM0_ is accepted cryptocurrency",
      "category": "Configuration",
      "isCondition": true,
      "parameters": [
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": "Javascript",
              "parameters": ["const coinType = arguments[0]; return window.PaymentSDK && window.PaymentSDK.acceptedCoins && window.PaymentSDK.acceptedCoins.has(coinType);"]
            }
          ],
          "actions": [],
          "events": []
        }
      ]
    },
    {
      "name": "GetTransactionHash",
      "fullName": "Get Last Transaction Hash",
      "description": "Get hash of last transaction",
      "sentence": "Last transaction hash",
      "category": "Payments",
      "isExpression": true,
      "expressionType": "string",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["if (!window.PaymentSDK) window.PaymentSDK = { lastTransactionHash: null }; const result = window.PaymentSDK.lastTransactionHash || 'none'; return result;"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "GetWalletAddress",
      "fullName": "Get Wallet Address",
      "description": "Get wallet address for cryptocurrency",
      "sentence": "Wallet address for _PARAM0_",
      "category": "Wallet",
      "isExpression": true,
      "expressionType": "string",
      "parameters": [
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"}
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["const coinType = arguments[0]; if (!window.PaymentSDK || !window.PaymentSDK.wallets) return ''; const wallet = window.PaymentSDK.wallets[coinType]; return wallet ? wallet.address : '';"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "GetConvertedAmount",
      "fullName": "Get Converted Amount",
      "description": "Get converted cryptocurrency amount",
      "sentence": "Converted amount",
      "category": "Conversion",
      "isExpression": true,
      "expressionType": "number",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["if (!window.PaymentSDK) window.PaymentSDK = { convertedAmount: 0 }; return window.PaymentSDK.convertedAmount || 0;"]
            }
          ],
          "events": []
        }
      ]
    },
    {
      "name": "GetSDKVersion",
      "fullName": "Get SDK Version",
      "description": "Get SDK version",
      "sentence": "SDK version",
      "category": "Payments",
      "isExpression": true,
      "expressionType": "string",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": "Javascript",
              "parameters": ["return '1.0.0';"]
            }
          ],
          "events": []
        }
      ]
    }
  ]
}
