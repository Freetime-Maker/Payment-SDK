{
  "author": "FreetimeMaker",
  "category": "Ads",
  "extensionNamespace": "PaymentSDK",
  "fullName": "PaymentSDK - Crypto Payments & Donations",
  "gdevelopVersion": "5.0+",
  "helpPath": "https://github.com/FreetimeMaker/Payment-SDK",
  "name": "PaymentSDK",
  "shortDescription": "Accept Crypto Payments & Donations in GDevelop Games",
  "version": "1.0.0",
  "description": "The Official GDevelop Port of FreetimeSDK - Accept multiple cryptocurrencies for payments and donations directly in your games.",
  "tags": ["payment", "cryptocurrency", "bitcoin", "ethereum", "donation", "wallet", "usd", "crypto", "blockchain", "monetization", "web3"],
  "authorIds": ["OAukac52NaXxAEaa7e3XaqhS0H32"],
  "dependencies": [],
  "globalVariables": [],
  "sceneVariables": [],
  "eventsFunctions": [
    {
      "name": "InitializePaymentSDK",
      "fullName": "Initialize Payment SDK",
      "type": "action",
      "description": "Initialize the Payment SDK",
      "category": "Payments"
    },
    {
      "name": "SetUserWalletAddress",
      "fullName": "Set User Wallet Address",
      "type": "action",
      "description": "Configure a wallet address for a cryptocurrency",
      "category": "Wallet",
      "parameters": [
        {"name": "coinType", "type": "string", "description": "Cryptocurrency type"},
        {"name": "address", "type": "string", "description": "Wallet address"},
        {"name": "name", "type": "string", "description": "Wallet name", "optional": true}
      ]
    },
    {
      "name": "SetAcceptedCryptocurrencies",
      "fullName": "Set Accepted Cryptocurrencies",
      "type": "action",
      "description": "Define which cryptocurrencies to accept",
      "category": "Configuration",
      "parameters": [
        {"name": "cryptocurrencies", "type": "string", "description": "Comma-separated list"}
      ]
    },
    {
      "name": "SendCryptocurrency",
      "fullName": "Send Cryptocurrency",
      "type": "action",
      "description": "Send cryptocurrency to a recipient",
      "category": "Payments",
      "parameters": [
        {"name": "fromAddress", "type": "string"},
        {"name": "toAddress", "type": "string"},
        {"name": "amount", "type": "number"},
        {"name": "coinType", "type": "string"},
        {"name": "includeFees", "type": "boolean", "optional": true}
      ]
    },
    {
      "name": "ProcessDonation",
      "fullName": "Process Donation",
      "type": "action",
      "description": "Process a cryptocurrency donation",
      "category": "Donations",
      "parameters": [
        {"name": "amount", "type": "number"},
        {"name": "coinType", "type": "string"},
        {"name": "donorWallet", "type": "string"},
        {"name": "noFees", "type": "boolean", "optional": true}
      ]
    },
    {
      "name": "ConvertUSDToCryptocurrency",
      "fullName": "Convert USD to Cryptocurrency",
      "type": "action",
      "description": "Convert USD to cryptocurrency",
      "category": "Conversion",
      "parameters": [
        {"name": "usdAmount", "type": "number"},
        {"name": "coinType", "type": "string"}
      ]
    },
    {
      "name": "GetFeeEstimate",
      "fullName": "Get Fee Estimate",
      "type": "action",
      "description": "Get estimated transaction fees",
      "category": "Fees",
      "parameters": [
        {"name": "fromAddress", "type": "string"},
        {"name": "toAddress", "type": "string"},
        {"name": "amount", "type": "number"},
        {"name": "coinType", "type": "string"}
      ]
    }
  ],
  "eventsConditions": [
    {
      "name": "IsSDKInitialized",
      "fullName": "Is SDK Initialized",
      "type": "condition",
      "description": "Check if Payment SDK is initialized",
      "category": "Payments"
    },
    {
      "name": "IsWalletConfigured",
      "fullName": "Is Wallet Configured",
      "type": "condition",
      "description": "Check if wallet is configured",
      "category": "Wallet",
      "parameters": [
        {"name": "coinType", "type": "string"}
      ]
    },
    {
      "name": "IsCryptocurrencyAccepted",
      "fullName": "Is Cryptocurrency Accepted",
      "type": "condition",
      "description": "Check if cryptocurrency is accepted",
      "category": "Configuration",
      "parameters": [
        {"name": "coinType", "type": "string"}
      ]
    },
    {
      "name": "IsTransactionConfirmed",
      "fullName": "Is Transaction Confirmed",
      "type": "condition",
      "description": "Check if transaction is confirmed",
      "category": "Payments",
      "parameters": [
        {"name": "txHash", "type": "string", "optional": true}
      ]
    }
  ],
  "eventsExpressions": [
    {
      "name": "GetTransactionHash",
      "fullName": "Get Last Transaction Hash",
      "type": "expression",
      "description": "Get hash of last transaction",
      "returnType": "string",
      "category": "Payments"
    },
    {
      "name": "GetFeeEstimate",
      "fullName": "Get Fee Estimate",
      "type": "expression",
      "description": "Get estimated fee",
      "returnType": "string",
      "category": "Fees"
    },
    {
      "name": "GetWalletAddress",
      "fullName": "Get Wallet Address",
      "type": "expression",
      "description": "Get wallet address for cryptocurrency",
      "returnType": "string",
      "category": "Wallet",
      "parameters": [
        {"name": "coinType", "type": "string"}
      ]
    },
    {
      "name": "GetConvertedAmount",
      "fullName": "Get Converted Amount",
      "type": "expression",
      "description": "Get converted cryptocurrency amount",
      "returnType": "string",
      "category": "Conversion"
    },
    {
      "name": "GetTransactionConfirmations",
      "fullName": "Get Transaction Confirmations",
      "type": "expression",
      "description": "Get number of confirmations",
      "returnType": "number",
      "category": "Payments",
      "parameters": [
        {"name": "txHash", "type": "string", "optional": true}
      ]
    },
    {
      "name": "GetDeepLink",
      "fullName": "Get Deep Link",
      "type": "expression",
      "description": "Get generated deep link",
      "returnType": "string",
      "category": "Wallet"
    }
  ]
}
